<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vista.actividades.User">

    <TextView
        android:id="@+id/UsuarioNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="dddd"
        tools:layout_editor_absoluteX="17dp"
        tools:layout_editor_absoluteY="23dp"

        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/textHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Historial"
        tools:layout_editor_absoluteX="19dp"
        tools:layout_editor_absoluteY="72dp"
        app:layout_constraintTop_toTopOf="@id/UsuarioNombre"
        android:layout_marginTop="100dp"
        app:layout_constraintStart_toStartOf="@id/UsuarioNombre"/>

    <androidx.fragment.app.FragmentContainerView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/fragUser"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textHistorial"
        android:layout_marginTop="30dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>